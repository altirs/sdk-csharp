    <LangVersion>10.0</LangVersion>
    <Nullable>enable</Nullable>
    <PackageId>Altirs.Sdk</PackageId>
    <Version>0.1.0</Version>
    <Authors>Altirs</Authors>
    <Description>C# SDK for Altirs — Guardrails-as-a-Service API</Description>
